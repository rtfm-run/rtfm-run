#!/bin/bash
# Writes /etc/rtfm/service.env from Secret Manager using the VM's service
# account. Secrets never touch the image or the instance metadata.
set -euo pipefail
source /etc/rtfm/deploy.env   # PROJECT, REGION, BASE_URL, DASHBOARD_URL, DB_USER, DB_NAME
secret() { gcloud secrets versions access latest --project "$PROJECT" --secret "$1"; }
umask 077
tmp=$(mktemp /etc/rtfm/.service.env.XXXXXX)
{
  echo "RTFM_DATABASE_URL=postgres://${DB_USER}:$(secret rtfm-db-password)@127.0.0.1:5432/${DB_NAME}?sslmode=disable"
  echo "RTFM_SECRET_KEY=$(secret rtfm-secret-key)"
  echo "RTFM_BASE_URL=${BASE_URL}"
  echo "RTFM_DASHBOARD_URL=${DASHBOARD_URL}"
  echo "GITHUB_APP_ID=$(secret rtfm-github-app-id)"
  echo "GITHUB_APP_PRIVATE_KEY_FILE=/etc/rtfm/github-app.pem"
  echo "RTFM_WORKERS=${RTFM_WORKERS:-3}"
  echo "RTFM_WORKER_FLAGS=${RTFM_WORKER_FLAGS:-}"
} > "$tmp"
secret rtfm-github-app-key > /etc/rtfm/github-app.pem
chown root:rtfm "$tmp" /etc/rtfm/github-app.pem
chmod 0640 "$tmp" /etc/rtfm/github-app.pem
mv "$tmp" /etc/rtfm/service.env
